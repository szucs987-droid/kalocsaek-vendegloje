      <button role="tab" data-mtab="salata" aria-selected="false" aria-controls="panel-salata">Saláták</button>
      <button role="tab" data-mtab="szosz" aria-selected="false" aria-controls="panel-szosz">Szószok</button>
      <button role="tab" data-mtab="desszert" aria-selected="false" aria-controls="panel-desszert">Desszertek</button>
      <button role="tab" data-mtab="italok" aria-selected="false" aria-controls="panel-italok">Italok</button>
