      <div class="mpanel" id="panel-porkolt" data-mpanel="porkolt" role="tabpanel">
        <div class="mrow"><span class="txt"><span class="nm">Csülök pörkölt</span><span class="ds">Igazi cupákos sertéscsülök-pörkölt.</span></span><span class="mid"></span><span class="pr">3 350 Ft</span></div>
