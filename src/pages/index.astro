---
import Layout from '../layouts/Layout.astro';

// Server-side open/closed using Budapest timezone
const now = new Date();
const bp = new Date(now.toLocaleString('en-US', { timeZone: 'Europe/Budapest' }));
const todayDay = bp.getDay(); // 0=Sun
const currentHour = bp.getHours() + bp.getMinutes() / 60;
const hrs: Record<number, [number, number]> = {
  0:[11,21], 1:[11,21], 2:[11,21], 3:[11,21], 4:[11,21], 5:[11,22], 6:[11,22],
};
const isOpen = currentHour >= hrs[todayDay][0] && currentHour < hrs[todayDay][1];
---

<Layout>
  <!-- ===== HEADER ===== -->
  <header class="nav" id="nav">
    <div class="logo">
      <span class="brandmark" role="img" aria-label="Kalocsáék Vendéglője 1957 logó"></span>
      <span class="brandtext">Kalocsáék Vendéglője <span class="yr">1957</span></span>
    </div>
    <nav class="links" aria-label="Fő navigáció">
      <a href="#etlap">Étlap</a>
      <a href="#rendezvenyek">Rendezvények</a>
      <a href="#galeria">Galéria</a>
      <a href="#kapcsolat">Kapcsolat</a>
    </nav>
    <a class="cta" href="#foglalas">Asztalfoglalás</a>
    <button class="burger" aria-label="Menü megnyitása" aria-expanded="false" aria-controls="mobile-menu">☰</button>
  </header>

  <!-- Mobile drawer -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav>
      <a href="#etlap">Étlap</a>
      <a href="#rendezvenyek">Rendezvények</a>
      <a href="#galeria">Galéria</a>
      <a href="#kapcsolat">Kapcsolat</a>
      <a href="#foglalas" class="cta-mobile">Asztalfoglalás</a>
    </nav>
  </div>

  <!-- ===== HERO ===== -->
  <section class="hero" id="fooldal">
    <div class="herobg herobg-table" aria-hidden="true"></div>
    <div class="herobg herobg-garden" aria-hidden="true"></div>
    <div class="scrim" aria-hidden="true"></div>
    <div class="hero-inner">
      <span class="badge">Anno 1957 · Cegléd</span>
      <h1>Kalocsáék Vendéglője</h1>
      <p class="slogan">„Szépet, jót, finomat!"</p>
      <p class="hero-sub">Házias magyar konyha hangulatos kertben — pergola, kemence és igazi<br>családi vendéglátás 1957 óta.</p>
      <div class="hero-btns">
        <a class="btn btn-gold" href="#foglalas">Asztalfoglalás</a>
        <a class="btn btn-cream" href="#ajanlat">Napi menü</a>
        <a class="btn btn-ghost" href="#etlap">Étlap megtekintése</a>
      </div>
    </div>
  </section>

  <!-- ===== QUICK ACTIONS ===== -->
  <div class="quick">
    <a href="tel:+36707720291">
      <span class="ic" aria-hidden="true">📞</span>Hívás<small>+36 70 772 0291</small>
    </a>
    <a href="https://maps.google.com/?q=2700+Cegléd,+Kőrösi+út+36" target="_blank" rel="noopener">
      <span class="ic" aria-hidden="true">📍</span>Útvonal<small>Kőrösi út 36, Cegléd</small>
    </a>
    <a href="#etlap">
      <span class="ic" aria-hidden="true">🍽️</span>Étlap<small>2026 étlap</small>
    </a>
    <a href="#kapcsolat">
      <span class="ic" aria-hidden="true">🕒</span>Nyitvatartás
      <small class:list={[isOpen ? 'open' : 'closed']}>
        {isOpen ? 'Ma nyitva' : 'Ma zárva'}
      </small>
    </a>
  </div>

  <!-- ===== STORY ===== -->
  <section class="sec story" id="tortenетünk">
    <div class="story-text">
      <div class="eyebrow">Történetünk</div>
      <h2>Három generáció, egy konyha</h2>
      <p class="lead">1957 óta főzünk magyaros, házias ízekkel. A vendéglőt Kalocsa János és felesége nyitotta a Kőrösi úton; az ízeket és a vendégszeretetet azóta a család harmadik generációja viszi tovább — bővülő kerttel, kemencével és 100 éves szőlő-pergolával.</p>
      <p class="founders">Alapítók: <strong>Kalocsa János</strong> és <strong>Király Erzsébet</strong> · 67+ éve a vendégeink szolgálatában</p>
      <div class="timeline">
        <div><strong>1957</strong><span>Alapítás</span></div>
        <div><strong>1992</strong><span>Új generáció</span></div>
        <div><strong>2006</strong><span>Bővítés</span></div>
        <div><strong>2016</strong><span>Kert &amp; pergola</span></div>
      </div>
    </div>
    <div class="story-photo">
      <img src="/vendeglo_1970_3_atlatszo.png" alt="A vendéglő anno — a Kőrösi úti épület, 1970-es évek" width="560" height="420" loading="lazy" />
    </div>
  </section>

  <!-- ===== MENU ===== -->
  <section class="sec sec-alt menu-sec" id="etlap">
    <div class="eyebrow">Étlap</div>
