---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { cfEnv } from '../lib/env';
import { parseAllergens, ALLERGENS } from '../lib/allergens';

// Fallback képek: akkor látszanak, ha az adatbázis üres vagy nem elérhető.
// Ha az admin feltölt képeket, ezek helyett azok jelennek meg.
const FALLBACK_GALLERY = [
  { cloudinary_url: 'https://cdn.website.dish.co/media/ea/10/3211641/Kalocsaek-Vendegloje-21122272-1506550899383656-3829873631109190797-o.jpg', alt_text: 'Kerthelyiség, hangulatvilágítással' },
  { cloudinary_url: 'https://cdn.website.dish.co/media/d6/c2/3211626/Kalocsaek-Vendegloje-21083250-1506550879383658-4573451657324914661-o.jpg', alt_text: 'Belső termünk, tánctérrel' },
  { cloudinary_url: 'https://cdn.website.dish.co/media/dc/ad/3211651/Kalocsaek-Vendegloje-21167069-1506550906050322-2998888195887132782-o.jpg', alt_text: 'Pergola, szőlőlugas a kertben' },
  { cloudinary_url: 'https://cdn.website.dish.co/media/dd/47/3211671/Kalocsaek-Vendegloje-130835177-3640366182668773-1406645070084188086-o.jpg', alt_text: 'Bőséges sültestál' },
  { cloudinary_url: 'https://cdn.website.dish.co/media/85/e7/3211621/Kalocsaek-Vendegloje-21083186-1506550972716982-3483539529075078717-o.jpg', alt_text: 'Rendezvényterem fényfüzérrel' },
  { cloudinary_url: 'https://cdn.website.dish.co/media/75/be/3211591/Kalocsaek-Vendegloje-527714-530192393686183-1332935311-n.jpg', alt_text: 'Kemencés sültek' },
  { cloudinary_url: 'https://cdn.website.dish.co/media/65/72/3211601/Kalocsaek-Vendegloje-10492308-865789876793098-6227095371384042938-n.jpg', alt_text: 'Svédasztalos tálalás rendezvényre' },
];

type GalleryImage = { cloudinary_url: string; alt_text: string };
let galleryImages: GalleryImage[] = FALLBACK_GALLERY;

const db = cfEnv.DB;
if (db) {
  try {
    const { results } = await db.prepare(
      'SELECT cloudinary_url, alt_text FROM gallery_images WHERE is_active = 1 ORDER BY sort_order, uploaded_at DESC'
    ).all<GalleryImage>();
    if (results.length > 0) galleryImages = results;
  } catch { /* DB nem inicializált — fallback képek maradnak */ }
}

// ===== MENU =====
type MenuItem = {
  id: number;
  category: string;
  subcategory: string | null;
  name: string;
  description: string | null;
  price_display: string | null;
  allergens: string | null;
  sort_order: number;
};

let menuItems: MenuItem[] = [];
if (db) {
  try {
    const { results } = await db.prepare(
      'SELECT id, category, subcategory, name, description, price_display, allergens, sort_order FROM menu_items WHERE is_active = 1 ORDER BY sort_order, name'
    ).all<MenuItem>();
    menuItems = results;
  } catch { /* DB nem inicializált — üres menü */ }
}

const menuGrouped: Record<string, MenuItem[]> = {};
for (const item of menuItems) {
  if (!menuGrouped[item.category]) menuGrouped[item.category] = [];
  menuGrouped[item.category].push(item);
}
const menuCategories = Object.keys(menuGrouped);

function slugify(s: string): string {
  return s.toLowerCase()
    .replace(/á/g,'a').replace(/é/g,'e').replace(/í/g,'i')
    .replace(/ó/g,'o').replace(/ö/g,'o').replace(/ő/g,'o')
    .replace(/ú/g,'u').replace(/ü/g,'u').replace(/ű/g,'u')
    .replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
}

function groupBySub(items: MenuItem[]): { sub: string | null; rows: MenuItem[] }[] {
  const seen = new Map<string | null, MenuItem[]>();
  const order: (string | null)[] = [];
  for (const item of items) {
    const sub = item.subcategory || null;
    if (!seen.has(sub)) { seen.set(sub, []); order.push(sub); }
    seen.get(sub)!.push(item);
  }
  return order.map(sub => ({ sub, rows: seen.get(sub)! }));
}
