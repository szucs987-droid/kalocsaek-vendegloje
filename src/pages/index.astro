    <h3 class="menu-section-label">Kiemelt ajánlatunk</h3>
    <div class="menu-cards">
      <div class="menu-card">
        <div class="menu-card-photo">
          <img src="/kalocsa_table_2.png" alt="Marha pörkölt galuskával" loading="lazy" style="object-position:34% 70%" />
        </div>
        <div class="menu-card-body">
          <h3>Marha pörkölt galuskával</h3>
          <p>Lassú tűzön főtt marhanyak, kalocsai paprikával, házi galuskával.</p>
          <span class="price">3 950 Ft</span>
        </div>
      </div>
      <div class="menu-card">
        <div class="menu-card-photo">
          <img src="https://cdn.website.dish.co/media/dd/47/3211671/Kalocsaek-Vendegloje-130835177-3640366182668773-1406645070084188086-o.jpg" alt="Sültes tálak" loading="lazy" />
        </div>
        <div class="menu-card-body">
          <h3>Sültes tálak</h3>
          <p>Bőséges tálak 2–4 főre — a Kalocsa táltól a Retró tálig.</p>
          <span class="price">9 350 Ft-tól</span>
        </div>
      </div>
      <div class="menu-card">
        <div class="menu-card-photo">
