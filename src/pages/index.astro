        <div class="mrow"><span class="txt"><span class="nm">Tárkonyos raguleves</span><span class="ds">Friss tárkonnyal, pirított csirkemell-kockákkal.</span></span><span class="mid"></span><span class="pr">1 750 Ft</span></div>
        <div class="mrow"><span class="txt"><span class="nm">Újházi tyúkhúsleves csigatésztával</span><span class="ds">Lakodalmas tyúkhúsleves zöldségekkel, borsóval, csigatésztával.</span></span><span class="mid"></span><span class="pr">1 850 Ft</span></div>
        <div class="mrow"><span class="txt"><span class="nm">Babgulyás füstölt csülökkel</span><span class="ds">Fejtett babbal, füstölt csülökkel, kalocsai paprikával, galuskával.</span></span><span class="mid"></span><span class="pr">1 950 Ft</span></div>
        <div class="mrow"><span class="txt"><span class="nm">Marhagulyás</span><span class="ds">Lassú tűzön főtt marhanyak, kalocsai paprikával, burgonyával.</span></span><span class="mid"></span><span class="pr">2 350 Ft</span></div>
        <div class="mrow"><span class="txt"><span class="nm">Harcsa halászlé bográcsban</span><span class="ds">Vegyes hal alaplé, afrikai harcsafilével tálalva.</span></span><span class="mid"></span><span class="pr">3 350 Ft</span></div>
