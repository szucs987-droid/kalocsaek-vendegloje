        <div class="mrow"><span class="txt"><span class="nm">Három kismalac</span><span class="ds">Sonkás-sajtos panírozott falatok, körettel.</span></span><span class="mid"></span><span class="pr">2 650 Ft</span></div>
        <div class="mrow"><span class="txt"><span class="nm">Egér lakoma</span><span class="ds">Bundás (rántott) sajt, körettel.</span></span><span class="mid"></span><span class="pr">2 650 Ft</span></div>
