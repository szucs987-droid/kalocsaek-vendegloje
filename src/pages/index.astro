        <div class="mrow"><span class="txt"><span class="nm">1957 Retró tál</span><span class="ds">Rántott gomba, sajt, szezámos szelet, cordon bleu, csirke steak, burgonya, rizs.</span></span><span class="mid"></span><span class="pr">18 250 Ft</span></div>
        <div class="mrow"><span class="txt"><span class="nm">Családi tál</span><span class="ds">Rántott csirkemell, sajt, mátrai borzas, cigánypecsenye, kanász király lakomája, burgonya, rizs.</span></span><span class="mid"></span><span class="pr">19 900 Ft</span></div>
        <div class="mrow"><span class="txt"><span class="nm">Kalocsa tál</span><span class="ds">Séf gomba, hagymakarika, cordon bleu, pelyhes pipi, tomahawk, füstölt csülök, kacsacomb, burgonya, mártogatósok.</span></span><span class="mid"></span><span class="pr">22 900 Ft</span></div>
