      <button role="tab" data-mtab="sultes" aria-selected="false" aria-controls="panel-sultes">Sültes tálak</button>
      <button role="tab" data-mtab="gyerek" aria-selected="false" aria-controls="panel-gyerek">Gyerek</button>
      <button role="tab" data-mtab="szarnyas" aria-selected="false" aria-controls="panel-szarnyas">Szárnyasok</button>
