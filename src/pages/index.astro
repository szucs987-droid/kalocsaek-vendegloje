  .sdots button.active { background: var(--gold-light); transform: scale(1.3); }

  /* ===== CONTACT ===== */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 20px;
  }
  @media (min-width: 760px) { .contact-grid { grid-template-columns: 1.05fr .95fr; } }

  .hours-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px 22px;
    box-shadow: var(--shadow-sm);
  }
  .hc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .hc-top h3 { margin: 0; color: var(--wine); font-size: 1.05rem; }

  .hc-status {
    font-size: .75rem;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: 20px;
    letter-spacing: .5px;
    background: var(--cream);
    color: var(--muted);
  }
  .hc-status.open { background: #e6f2ea; color: #2f6d4f; }
  .hc-status.closed { background: #f5e7e2; color: var(--terra-deep); }

  .hc-days { list-style: none; margin: 0; padding: 0; }
  .hc-days li {
    display: flex;
    justify-content: space-between;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: .9rem;
  }
  .hc-days li.today { background: var(--cream); }
  .hc-days li.today span,
  .hc-days li.today strong { color: var(--wine); font-weight: 800; }

  .hc-contact {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: .875rem;
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }
  .hc-contact a { color: var(--ink); transition: color .15s; }
  .hc-contact a:hover { color: var(--wine); }

  .map-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    min-height: 300px;
    background: #dfe4d6;
  }
  .map-card iframe {
    width: 100%; height: 100%;
    position: absolute;
    inset: 0;
    border: 0;
  }
  .map-overlay {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 14px 16px;
    background: linear-gradient(transparent, rgba(40,12,16,.72));
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  .map-overlay span { color: #fff; font-size: .8rem; text-shadow: 0 1px 4px rgba(0,0,0,.5); }

  /* ===== BOOKING ===== */
  .booking-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  /* ===== FOOTER ===== */
  .footer {
    background: var(--wine-deep);
    color: #ecdcc9;
    text-align: center;
    padding: 28px 20px;
    font-size: .8rem;
    line-height: 2;
  }
  .footer-name {
    display: block;
    font-family: var(--font-serif);
    font-size: .95rem;
    color: var(--gold-light);
    margin-bottom: 4px;
  }
  .footer-links { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; margin: 8px 0; }
  .footer-links a { color: var(--gold-light); transition: color .15s; }
  .footer-links a:hover { color: #fff; }
  .footer-copy { color: rgba(236,220,201,.5); margin-top: 8px; }

  /* ===== MOBILE BOTTOM BAR ===== */
  .mbar {
    position: sticky;
    bottom: 0;
    z-index: 12;
    display: flex;
    background: var(--wine);
    border-top: 3px solid var(--gold);
  }
  .mbar a {
    flex: 1;
    text-align: center;
    color: #fff;
    text-decoration: none;
    padding: 13px 4px;
    font-size: .7rem;
    font-weight: 700;
    transition: background .15s;
  }
  .mbar a + a { border-left: 1px solid rgba(255,255,255,.18); }
  .mbar a span { display: block; font-size: 1.1rem; margin-bottom: 2px; }
  .mbar-hi { background: var(--gold); color: #3a2708 !important; }
  .mbar-hi:hover { background: var(--gold-light) !important; }

  @media (min-width: 640px) { .mbar { display: none; } }
</style>

<script>
  // Hide header logo / show sidebar watermark when menu section is in view
  (function () {
    const etlap = document.getElementById('etlap');
    const brandmark = document.querySelector<HTMLElement>('.brandmark');
    const sidebar = document.querySelector<HTMLElement>('.menu-sidebar');
    if (!etlap || !brandmark) return;

    const obs = new IntersectionObserver(
      ([entry]) => {
        const inMenu = entry.isIntersecting;
        brandmark.classList.toggle('menu-active', inMenu);
        sidebar?.classList.toggle('visible', inMenu);
      },
      {
        // Fire when #etlap top crosses below the sticky nav (64px)
        rootMargin: '-64px 0px 0px 0px',
        threshold: 0,
      }
    );
    obs.observe(etlap);
  })();

  // Hero background rotation (15s)
  const hero = document.querySelector('.hero') as HTMLElement | null;
  if (hero) {
    setInterval(() => hero.classList.toggle('show-garden'), 15000);
  }

  // Menu tabs
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('.mtabs [data-mtab]');
    if (!btn) return;
    const sec = btn.closest('.menu-sec');
    if (!sec) return;
    sec.querySelectorAll<HTMLButtonElement>('.mtabs [data-mtab]').forEach(b => {
      b.classList.remove('active');
      b.setAttribute('aria-selected', 'false');
    });
    btn.classList.add('active');
    btn.setAttribute('aria-selected', 'true');
    const id = btn.dataset.mtab!;
    sec.querySelectorAll<HTMLElement>('.mpanel').forEach(p => {
      p.classList.toggle('active', p.dataset.mpanel === id);
    });
  });

  // Gallery slider
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach(sl => {
    const slides = sl.querySelectorAll<HTMLElement>('.slide');
    if (!slides.length) return;
    const dotsWrap = sl.querySelector<HTMLElement>('.sdots')!;
    let idx = 0, timer: ReturnType<typeof setInterval>;

    slides.forEach((_, i) => {
      const d = document.createElement('button');
      d.setAttribute('role', 'listitem');
      d.setAttribute('aria-label', `${i + 1}. kép`);
      if (i === 0) d.className = 'active';
      d.addEventListener('click', () => { go(i); reset(); });
      dotsWrap.appendChild(d);
    });
    const dots = dotsWrap.querySelectorAll<HTMLButtonElement>('button');

    function go(n: number) {
      slides[idx].classList.remove('active');
      dots[idx].classList.remove('active');
      idx = (n + slides.length) % slides.length;
      slides[idx].classList.add('active');
      dots[idx].classList.add('active');
    }
    function reset() {
      clearInterval(timer);
      timer = setInterval(() => go(idx + 1), 3000);
    }

    sl.querySelector('[data-prev]')?.addEventListener('click', () => { go(idx - 1); reset(); });
    sl.querySelector('[data-next]')?.addEventListener('click', () => { go(idx + 1); reset(); });
    timer = setInterval(() => go(idx + 1), 3000);
  });

  // Open/closed indicator — computed client-side in Budapest timezone
  (function () {
    const now = new Date();
    const bp = new Date(now.toLocaleString('en-US', { timeZone: 'Europe/Budapest' }));
    const day = bp.getDay(); // 0=Sun
    const hour = bp.getHours() + bp.getMinutes() / 60;
    // Fri(5) + Sat(6) close at 22:00, every other day at 21:00
    const closeH = (day === 5 || day === 6) ? 22 : 21;
    const isOpen = hour >= 11 && hour < closeH;

    // Quick-actions row
    const sq = document.getElementById('status-quick');
    if (sq) { sq.textContent = isOpen ? 'Most nyitva' : 'Most zárva'; sq.className = isOpen ? 'open' : 'closed'; }

    // Hours-card badge
    const sb = document.getElementById('status-badge');
    if (sb) { sb.textContent = isOpen ? 'Most nyitva' : 'Most zárva'; sb.classList.add(isOpen ? 'open' : 'closed'); }

    // Today day highlight
    document.querySelectorAll<HTMLElement>('.hc-days li[data-day]').forEach(li => {
      if (parseInt(li.dataset.day ?? '-1') === day) li.classList.add('today');
    });
  })();

  // ===== Rendezvény ajánlatkérő form =====
  (function () {
    const toggleBtn = document.getElementById('rendezv-toggle') as HTMLButtonElement | null;
    const panel     = document.getElementById('rendezv-panel');
    const form      = document.getElementById('rendezv-form') as HTMLFormElement | null;
    const tipusSel  = document.getElementById('rf-tipus')  as HTMLSelectElement | null;
    const egyebWrap = document.getElementById('rf-egyeb-wrap');
    const egyebInp  = document.getElementById('rf-egyeb')  as HTMLInputElement | null;

    // Toggle kinyitás/becsukás
    if (toggleBtn && panel) {
      toggleBtn.addEventListener('click', () => {
        const open = panel.classList.toggle('open');
        toggleBtn.setAttribute('aria-expanded', String(open));
        panel.setAttribute('aria-hidden', String(!open));
        if (open) setTimeout(() => panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 50);
      });
    }

    // Egyéb típus mező megjelenítése
    if (tipusSel && egyebWrap && egyebInp) {
      tipusSel.addEventListener('change', () => {
        const isEgyeb = tipusSel.value === 'Egyéb';
        egyebWrap.classList.toggle('visible', isEgyeb);
        egyebInp.required = isEgyeb;
      });
    }

    // Form beküldés: POST API-ra mentés + visszaigazolás
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const nev      = (document.getElementById('rf-nev')    as HTMLInputElement).value.trim();
        const tel      = (document.getElementById('rf-tel')    as HTMLInputElement).value.trim();
        const email    = (document.getElementById('rf-email')  as HTMLInputElement).value.trim();
        const tipus    = tipusSel?.value === 'Egyéb'
                          ? (egyebInp?.value.trim() || 'Egyéb')
                          : (tipusSel?.value || '');
        const letszam  = (document.getElementById('rf-letszam')  as HTMLInputElement).value.trim();
        const kezdete  = (document.getElementById('rf-kezdete')  as HTMLInputElement).value;
        const vege     = (document.getElementById('rf-vege')     as HTMLInputElement).value;
        const reszlet  = (document.getElementById('rf-reszlet') as HTMLTextAreaElement).value.trim();

        if (!nev || !tel || !tipus) {
          alert('Kérjük, töltse ki a kötelező mezőket (Név, Telefonszám, Rendezvény típusa).');
          return;
        }

        const btn = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
        btn.disabled = true;
        btn.textContent = 'Küldés…';

        try {
          const res = await fetch('/api/inquiries', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: nev, phone: tel, email: email || null,
              event_type: tipus,
              headcount: letszam ? Number(letszam) : null,
              starts_at: kezdete || null,
              ends_at: vege || null,
              details: reszlet || null,
            }),
          });

          if (!res.ok) throw new Error('API hiba');

          // Siker: visszaigazolás a form helyén
          form.innerHTML = `
            <div style="text-align:center;padding:2rem 1rem">
              <div style="font-size:2.5rem;margin-bottom:12px">✅</div>
              <p style="font-size:1.1rem;font-weight:700;color:var(--wine);font-family:Georgia,serif">
                Köszönjük érdeklődését!
              </p>
              <p style="color:var(--muted);margin-top:8px">
                Munkatársunk 24 órán belül felveszi Önnel a kapcsolatot.<br>
                Sürgős esetben hívjon minket: <a href="tel:+36707720291" style="color:var(--wine)">+36 70 772 0291</a>
              </p>
            </div>
          `;
        } catch {
          btn.disabled = false;
          btn.textContent = 'Ajánlatkérés elküldése';
          alert('Hiba történt a küldés során. Kérjük, hívjon minket: +36 70 772 0291');
        }
      });
    }
  })();

  // Mobile menu toggle
  const burgerBtn = document.querySelector<HTMLButtonElement>('.burger');
  const mobileMenu = document.getElementById('mobile-menu');
  if (burgerBtn && mobileMenu) {
    burgerBtn.addEventListener('click', () => {
      const open = mobileMenu.classList.toggle('open');
      burgerBtn.setAttribute('aria-expanded', String(open));
      mobileMenu.setAttribute('aria-hidden', String(!open));
    });
    // Close on link click
    mobileMenu.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        mobileMenu.classList.remove('open');
        burgerBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.setAttribute('aria-hidden', 'true');
      });
    });
  }
</script>
