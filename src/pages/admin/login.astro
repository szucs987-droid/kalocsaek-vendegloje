---
export const prerender = false;
import { cfEnv } from '../../lib/env';

// If already logged in, redirect to dashboard
const cookie = Astro.cookies.get('admin_session');
if (cfEnv.ADMIN_SECRET && cookie?.value === cfEnv.ADMIN_SECRET) {
  return Astro.redirect('/admin');
}

const error = Astro.url.searchParams.get('error');
---
<!doctype html>
<html lang="hu">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Bejelentkezés — Kalocsáék Admin</title>
  <style>
    :root {
      --wine: #7a1c2b; --wine-deep: #591019; --gold: #c08a2e;
      --cream2: #fcf7ec; --paper: #fffdf8; --ink: #3a2a22;
      --muted: #6e5d50; --line: #e7dcc8;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
      background: var(--wine-deep);
      display: flex; align-items: center; justify-content: center;
      min-height: 100vh; padding: 20px;
    }
    .card {
      background: var(--paper);
      border-radius: 16px;
      padding: 36px 32px;
      width: 100%; max-width: 380px;
      box-shadow: 0 20px 60px rgba(0,0,0,.35);
    }
    .logo {
      text-align: center;
      margin-bottom: 28px;
    }
    .logo h1 {
      font-family: Georgia, serif;
      color: var(--wine);
      font-size: 1.3rem;
      margin-bottom: 4px;
    }
    .logo p { color: var(--muted); font-size: .8rem; }
    label { display: block; font-size: .85rem; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
    input[type="password"] {
      width: 100%; padding: .65rem .9rem; font-size: 1rem;
      background: var(--cream2); border: 1.5px solid var(--line);
      border-radius: 8px; outline: none; color: var(--ink);
      transition: border-color .15s;
    }
    input[type="password"]:focus { border-color: var(--gold); }
    .btn {
      display: block; width: 100%; padding: .75rem;
      background: var(--wine); color: #fff;
      border: none; border-radius: 8px; font-size: 1rem;
      font-weight: 700; cursor: pointer; margin-top: 16px;
      transition: background .15s;
    }
    .btn:hover { background: var(--wine-deep); }
    .error {
      background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5;
      border-radius: 8px; padding: 10px 14px; font-size: .85rem;
      margin-top: 12px;
    }
    .back { text-align: center; margin-top: 18px; font-size: .8rem; color: var(--muted); }
    .back a { color: var(--wine); }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">
      <h1>Kalocsáék Admin</h1>
      <p>Vendéglő 1957 — Kezelőpanel</p>
    </div>
    <form id="login-form" novalidate>
      <label for="pw">Jelszó</label>
      <input type="password" id="pw" name="password" required autofocus placeholder="Admin jelszó" autocomplete="current-password" />
      <button type="submit" class="btn">Bejelentkezés</button>
      <div id="error-msg" class="error" style="display:none"></div>
    </form>
    <div class="back"><a href="/">← Vissza a honlapra</a></div>
  </div>

  <script>
    const form = document.getElementById('login-form');
    const errEl = document.getElementById('error-msg');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pw = (document.getElementById('pw') as HTMLInputElement).value;
      const btn = form.querySelector('button') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Bejelentkezés...';
      errEl!.style.display = 'none';

      const res = await fetch('/api/admin/auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: pw }),
      });

      if (res.ok) {
        window.location.href = '/admin';
      } else {
        const d = await res.json() as any;
        errEl!.textContent = d.error || 'Hiba történt.';
        errEl!.style.display = 'block';
        btn.disabled = false; btn.textContent = 'Bejelentkezés';
      }
    });
  </script>
</body>
</html>
